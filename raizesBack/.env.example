# Copie para .env (ou exporte as variaveis no terminal). Todas sao OPCIONAIS: sem elas a API usa H2 em memoria.
PORT=8080
# PostgreSQL (opcional) - suba com: docker compose up -d
DB_URL=jdbc:postgresql://localhost:5432/raizes
DB_USER=raizes
DB_PASSWORD=raizes123
# Segredo JWT (minimo 32 caracteres). TROQUE em producao.
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio-123456
JWT_EXPIRATION=3600
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
